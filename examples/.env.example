# Example .env file for ug-lua-llm
# Copy this file to .env and fill in the keys you need. Every variable is
# optional: a provider is simply unavailable when its key is absent, and
# Ollama needs no key at all.
#
# These names match the ones the client and `lua scripts/doctor.lua` look for.

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# xAI (Grok)
GROK_API_KEY=your-grok-api-key-here

# Groq
GROQ_API_KEY=your-groq-api-key-here

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key-here

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Mistral
MISTRAL_API_KEY=your-mistral-api-key-here

# An arbitrary OpenAI-compatible server (API key is optional)
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_MODEL=your-model-name
# OPENAI_COMPATIBLE_API_KEY=your-optional-api-key
